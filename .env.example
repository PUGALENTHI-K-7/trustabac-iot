# ==============================================================================
# TrustABAC-IoT Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit the real .env file to source control.
# ==============================================================================

# Application Gateway Port
SERVER_PORT=8090

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=trustabac_iot
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_ROOT_PASSWORD=your_root_database_password

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_MGMT_PORT=15672

# Ganache / Ethereum EVM Blockchain Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_PORT=8545
